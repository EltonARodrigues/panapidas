using Gtk 4.0;
using Adw 1;

template $PalapidasWindow: Adw.ApplicationWindow {
  title: _("Palapidas");
  default-width: 1000;
  default-height: 600;

  content: Adw.NavigationSplitView split_view {
    content: Adw.NavigationPage request_navigation {
      title: _("Request");

      child: Adw.NavigationView page_navigation_view {
        Adw.NavigationPage request_layout {
          title: _("Requests");

          Adw.ToolbarView content_request {
            [top]
            Adw.HeaderBar {
              [end]
              Button save_request_button {
                // sensitive: false;
                label: _("Save");

                styles [
                  "suggested-action",
                ]

                clicked => $on_save();
              }
            }
          }
        }

        $EnvConfigPage env_config_layout {
        }
      };
    };
  };
}
