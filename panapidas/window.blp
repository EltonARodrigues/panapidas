using Gtk 4.0;
using Adw 1;

template $PalapidasWindow: Adw.ApplicationWindow {
  title: _("Palapidas");
  default-width: 1000;
  default-height: 600;

  content: Adw.NavigationSplitView split_view {
    content: Adw.NavigationPage {
      title: _("Request");

      child: Adw.ToolbarView content_request {
        [top]
        Adw.HeaderBar {
          [end]
          MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
          }
        }
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Gazette");
      action: "app.about";
    }
  }
}
