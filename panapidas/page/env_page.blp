using Gtk 4.0;
using Adw 1;

template $EnvPage: Adw.NavigationPage {
  title: _("Envs");

  child: Adw.ToolbarView content_request {
    [top]
    Adw.HeaderBar {
      show-title: false;

      [center]
      Box {
        valign: center;
        halign: center;

        styles [
          "linked",
        ]

        SearchEntry search_entry {
          placeholder-text: _("Search Env");

          search-changed => $on_search_change();
        }

        Button add_env_button {
          label: _("Add New Env");
          icon-name: "list-add-symbolic";

          styles [
            "suggested-action",
          ]

          clicked => $on_create_env();
        }
      }
    }

    content: ScrolledWindow {
      has-frame: false;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 10;
      margin-end: 10;

      child: ListView list_envs {
        // hexpand: true;
        // valign: start;
        enable-rubberband: false;

        styles [
          "list-view-env",
        ]

        factory: SignalListItemFactory {
          setup => $on_setup_factory();
          bind => $on_bind_factory();
          unbind => $on_unbind_factory();
        };
      };
    }; 
  };
}
