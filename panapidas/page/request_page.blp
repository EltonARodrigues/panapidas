using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $RequestPage: Adw.Bin {
  child: Box {
    orientation: vertical;
    halign: fill;

    Box {
      orientation: horizontal;
      spacing: 5;

      Box {
        orientation: horizontal;

        styles [
          "linked",
        ]

        DropDown http_method_list {
          width-request: 100;

          model: SingleSelection {
            model: StringList method_list {
              strings: [
                "GET",
                "POST",
                "PATCH",
                "DELETE",
                "PUT",
              ];
            };

            selected: 0;
          };

          notify => $on_method_change();
        }

        Entry url_entry {
          hexpand: true;
          placeholder-text: _("Enter URL");
          changed => $on_url_change();
        }
      }

      Button {
        label: _("SEND");
        clicked => $on_send();
      }
    }

    Box {
      orientation: vertical;
      margin-top: 5;
      spacing: 5;

      Box {
        orientation: vertical;

        styles [
          "stack_box_request",
        ]

        Gtk.StackSwitcher {
          stack: stack;
          halign: fill;
        }

        Gtk.Stack stack {
          transition-type: crossfade;
          vexpand: false;

          Gtk.StackPage {
            name: "params";
            title: _("Params");

            child: Adw.Bin {
              hexpand: true;
              vexpand: true;

              ScrolledWindow {
                max-content-height: 200;
                hscrollbar-policy: never;
                propagate-natural-height: true;
                has-frame: false;
                valign: start;

                Gtk.ListBox request_params_list {
                  selection-mode: none;
                }
              }
            };
          }

          Gtk.StackPage {
            name: "headers";
            title: _("Headers");

            child: Adw.Bin {
              hexpand: true;
              vexpand: true;

              ScrolledWindow {
                hscrollbar-policy: never;
                propagate-natural-height: true;
                has-frame: false;
                valign: start;

                Gtk.ListBox request_header_list {
                  selection-mode: none;
                }
              }
            };
          }

          Gtk.StackPage {
            name: "body";
            title: _("Body");

            child: Box body_type_widget {
              orientation: vertical;

              Adw.ToggleGroup {
                active-name: "none";

                styles [
                  "toolbar",
                  "body_toggle",
                ]

                notify::active-name => $on_body_type_change();

                Adw.Toggle {
                  name: "none";
                  label: _("None");
                }

                Adw.Toggle {
                  name: "form_data";
                  label: _("form-data");
                }

                Adw.Toggle {
                  name: "form_urlencoded";
                  label: _("x-www-form-urlencoded");
                }

                Adw.Toggle {
                  name: "raw";
                  label: _("raw");
                }
              }

              ScrolledWindow body_type_request {
                max-content-height: 400;
                hscrollbar-policy: never;
                propagate-natural-height: true;
                has-frame: false;
                valign: start;
              }
            };
          }
        }
      }

      Box {
        height-request: 35;
        spacing: 5;

        styles [
          "response_status_bar",
        ]

        Label default_status_bar_label {
          label: _("Response");
        }

        Label response_status_label {
          visible: false;
          label: _("Status: {}");
        }

        Label response_time_label {
          visible: false;
          label: _("Time: {}");
        }

        Label response_size_label {
          visible: false;
          label: _("Size: {}");
        }
      }

      ScrolledWindow {
        height-request: 180;
        width-request: 600;
        has-frame: false;
        vexpand: true;

        styles [
          "textview",
        ]

        $BodySourceView response_body {}
      }
    }
  };
}
