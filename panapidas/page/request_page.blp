using Gtk 4.0;
using Adw 1;

template $RequestPage: Adw.Bin {

  child: Box {
    orientation: vertical;
    margin-start: 5;
    margin-end: 5;
    margin-top: 5;
    halign: fill;
    Box {
      orientation: horizontal;
      spacing: 5;

      Box {
        orientation: horizontal;

        styles [
          "linked",
        ]

        DropDown http_method_list {
          width-request: 100;

          model: SingleSelection {
            model: StringList method_list {
              strings: [
                "GET",
                "POST",
                "PATCH",
                "DELETE",
                "PUT",
              ];
            };

            selected: 0;
          };
        }

        Entry url_entry {
          hexpand: true;
          placeholder-text: _("Enter URL");
          changed => $on_url_change();
        }
      }

      Button {
        label: _("SEND");
        clicked => $on_send();
      }
    }

    Box {
      orientation: horizontal;
      margin-top: 5;
      spacing: 5;

      Box {
        orientation: vertical;
        spacing: 5;

        Gtk.StackSwitcher {
          stack: stack;
          halign: center;
        }

        Gtk.Stack stack {
          transition-type: crossfade;
          vexpand: false;

          Gtk.StackPage {
            name: "params";
            title: _("Params");

            child: Box {
              orientation: vertical;
              spacing: 5;
              hexpand: true;
              vexpand: true;

              ScrolledWindow {
                hscrollbar-policy: never;
                propagate-natural-height: true;
                has-frame: false;
                valign: start;

                Gtk.ListBox request_params_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }
              }
            };
          }

          Gtk.StackPage {
            name: "headers";
            title: _("Headers");

            child: Box {
              orientation: vertical;
              spacing: 5;
              hexpand: true;
              vexpand: true;

              ScrolledWindow {
                hscrollbar-policy: never;
                propagate-natural-height: true;
                has-frame: false;
                valign: start;

                Gtk.ListBox request_header_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }
              }
            };
          }

          Gtk.StackPage {
            name: "body";
            title: _("Body");

            child: Box body_type_widget {
              spacing: 5;
              orientation: vertical;
              height-request: 250;

              Adw.ToggleGroup {
                active-name: "none";

                styles [
                  "flat",
                ]

                notify::active-name => $on_body_type_change();

                Adw.Toggle {
                  name: "none";
                  label: _("None");
                }

                Adw.Toggle {
                  name: "form_data";
                  label: _("form-data");
                }

                Adw.Toggle {
                  name: "form_urlencoded";
                  label: _("x-www-form-urlencoded");
                }

                Adw.Toggle {
                  name: "raw";
                  label: _("raw");
                }
              }
            };
          }
        }
      }

      Adw.Bin {
        Gtk.TextView response_body {
          editable: false;
          monospace: true;
          hexpand: true;
          vexpand: true;
        }
      }
    }
  };
}
