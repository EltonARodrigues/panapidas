using Gtk 4.0;
using Adw 1;

template $PreferencesPage: Adw.PreferencesDialog {
  content-width: 800;
  content-height: 600;
  title: _("Preferences");

  Adw.PreferencesPage general_page {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Request Settings");
      description: _("Configure the request settings for the application");

      Adw.SpinRow {
        title: _("Request Timeout");
        subtitle: _("Increment or decrement request timeout");
        climb-rate: 0.2;

        adjustment: Adjustment {
          lower: 0;
          upper: 100;
          value: 10;
          step-increment: 1;
        };
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Certificate");
    icon-name: "application-certificate-symbolic";

    Adw.PreferencesGroup {
      title: _("Certificate Settings");
      description: _("Add or remove certificates for secure connections");

      [header-suffix]
      Button {
        halign: center;
        valign: center;
        icon-name: "value-increase-symbolic";

        clicked => $on_add_certificate();
      }
      
      ListBox cert_list_box {
        selection-mode: none;
      }
    }
  }
}