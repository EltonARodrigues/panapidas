using Gtk 4.0;
using Adw 1;

template $CopyCode: Box {
  halign: start;

  Gtk.Label text_label {
    wrap: true;
    xalign: 0;
    yalign: 0;

    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    styles [
      "monospace",
    ]
  }

  Button {
    icon-name: "edit-copy-symbolic";
    tooltip-text: "Copy to clipboard";

    styles [
      "flat"
    ]

    clicked => $copy_text();
  }

  styles [
    "osd",
    "code_copy"
  ]
}