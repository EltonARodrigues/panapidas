using Gtk 4.0;
using Adw 1;

template $RequestSidebar: Adw.NavigationPage {
  title: _("Collections");

  child: Adw.ToolbarView teste {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: request_item_menu;
      }
    }

    content: ScrolledWindow {
      child: ListView request_view {
        styles [
          "navigation-sidebar",
        ]

        factory: SignalListItemFactory factory {
          setup => $setup_factory();
          bind => $bind_factory();
        };
      };
    };
  };
}

menu request_item_menu {
  section {
    item {
      label: _("New Folder");
      action: 'app.create_folder';
    }

    item {
      label: _("New Request");
      action: 'app.create_request';
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Gazette");
      action: "app.about";
    }
  }
}
