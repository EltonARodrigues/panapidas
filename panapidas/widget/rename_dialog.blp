using Gtk 4.0;
using Adw 1;

template $RenameDialog: Adw.AlertDialog {
  close-response: "cancel";
  default-response: "save";

  responses [
    cancel: _("Cancel"),
    save: _("Rename") suggested,
  ]

  Entry rename_entry {
    placeholder-text: _("Enter new name");
    
    changed => $on_rename_change();
  }
}
